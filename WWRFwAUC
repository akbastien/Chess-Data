from sklearn.metrics import accuracy_score, classification_report
import warnings
from sklearn.model_selection import GroupShuffleSplit
warnings.filterwarnings('ignore')

w = ''
eig_data = pd.read_csv(r"C:\Users\avger\OneDrive\Documents\School Documents\Math Modeling\WhiteStatusAdjacencyData.csv")
X = eig_data[['NumPieces', 'AdjacencyEigs_zeros', 'AdjacencyEigs_minNonzero', 'AdjacencyEigs_max', 
              'AdjacencyEigsWW_zeros','AdjacencyEigsWW_minNonzero','AdjacencyEigsWW_max', 
              'AdjacencyEigsWB_zeros', 'AdjacencyEigsWB_minNonzero', 'AdjacencyEigsWB_max', 
              'AdjacencyEigsBB_zeros', 'AdjacencyEigsBB_minNonzero', 'AdjacencyEigsBB_max',
              'AdjacencyEigsBW_zeros', 'AdjacencyEigsBW_minNonzero', 'AdjacencyEigsBW_max']]
y = eig_data['Winner']
groups = eig_data['Game No']

gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)
train_idx, test_idx = next(gss.split(X, y, groups=groups))

X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]

#To create model
rf_classifier = RandomForestClassifier(n_estimators=100, random_state=42)
