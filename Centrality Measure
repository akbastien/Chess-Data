# ADJACENCY MATRIX GENERATION
def DistancetoAdjacency(distance_matrix):
    adjacency_matrix = []
    
    for row in distance_matrix:
        new_row = [1 if val == 1 else 0 for val in row]
        adjacency_matrix.append(new_row)
        
    return adjacency_matrix

